[Unit]
Description=PipeLink virtual audio routing daemon
Documentation=https://codeberg.org/kuroki-kael/pipelink
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipelink daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
