# Maintainer: Kuroki-Kael <kuroki@kuroki-kael.com>
pkgbase=pipelink
pkgname=('pipelink' 'pipelink-gui')
pkgver=0.1.1
pkgrel=1
pkgdesc='Virtual PipeWire/JACK audio routing daemon and CLI'
arch=('x86_64' 'aarch64')
url='https://codeberg.org/kuroki-kael/pipelink'
license=('GPL-3.0-or-later')
depends=('pipewire' 'pipewire-jack' 'wireplumber')
makedepends=('cargo' 'clang' 'pkgconf')
options=('!debug' '!lto')
source=("${pkgbase}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir() {
    if [[ -d "${srcdir}/${pkgbase}-${pkgver}" ]]; then
        printf '%s' "${srcdir}/${pkgbase}-${pkgver}"
    else
        printf '%s' "${srcdir}/${pkgbase}"
    fi
}

prepare() {
    cd "$(_srcdir)"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_srcdir)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p pipelink
    cp target/release/pipelink target/pipelink-headless
    cargo build --frozen --release -p pipelink --features gui
}

check() {
    cd "$(_srcdir)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace --all-features
}

package_pipelink() {
    cd "$(_srcdir)"
    make install DESTDIR="$pkgdir" PREFIX=/usr PIPELINK_BIN=target/pipelink-headless
}

package_pipelink-gui() {
    pkgdesc='Virtual PipeWire/JACK audio routing daemon, CLI, and graphical mixer'
    depends=('pipewire' 'pipewire-jack' 'wireplumber' 'hicolor-icon-theme')
    provides=('pipelink')
    conflicts=('pipelink')

    cd "$(_srcdir)"
    make install-gui DESTDIR="$pkgdir" PREFIX=/usr PIPELINK_BIN=target/release/pipelink
}
